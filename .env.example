# Secondary League Upload URL
# Set this to enable uploading replays to a secondary league website
# Leave empty or comment out to disable league uploads
LEAGUE_URL=

# Example:
# LEAGUE_URL=https://replays.jubgaming.com/api/upload

# Storm Prevention
# When enabled, adds a random delay (0-15 seconds by default) before each upload
# to prevent multiple players from uploading simultaneously after a game ends.
# This is configured in the app settings, not here. Use the app menu to toggle.

