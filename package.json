{
  "name": "wc3stats-auto-uploader",
  "version": "1.5.0",
  "description": "Automatically uploads Warcraft III replays to wc3stats.com.",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komodo123/wc3stats-auto-uploader.git"
  },
  "author": "Ethan Anders",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/komodo123/wc3stats-auto-uploader/issues"
  },
  "homepage": "https://github.com/komodo123/wc3stats-auto-uploader#readme",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-installer-windows": "^3.0.0",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0"
  },
  "dependencies": {
    "await-semaphore": "^0.1.3",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.7",
    "electron-fetch": "^1.9.1",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "form-data": "^4.0.5",
    "merge-deep": "^3.0.3",
